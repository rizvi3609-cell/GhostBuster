# Supabase project URL used only by server-side code.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key. Server-side only; never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Supabase project URL exposed to the browser for RLS-scoped Realtime subscriptions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key exposed to the browser for RLS-scoped Realtime subscriptions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Base URL of the clinic-owned n8n instance.
N8N_BASE_URL=https://your-clinic.app.n8n.cloud

# Shared secret used to HMAC-sign Next.js-to-n8n webhook requests.
N8N_SHARED_SECRET=replace-with-a-long-random-secret

# Human-readable clinic name used in staff UI and patient-safe SMS copy.
CLINIC_NAME=Example Dental

# IANA timezone used for quiet-hours checks and clinic-local rendering.
CLINIC_TIMEZONE=America/New_York

# Start of the clinic-local outbound sending window in 24-hour HH:MM format.
QUIET_HOURS_START=08:00

# End of the clinic-local outbound sending window in 24-hour HH:MM format.
QUIET_HOURS_END=20:00

# Maximum outbound messages allowed per patient in a trailing seven-day window.
MAX_MESSAGES_PER_WEEK=3

# Estimated recovered revenue per filled chair, used only for labeled estimates.
ESTIMATED_CHAIR_VALUE=350.00

# Enables V2 Stripe deposit holds when true.
FEATURE_STRIPE_DEPOSITS=false

# Enables V2 automated recall messages when true.
FEATURE_RECALLS=false

# Enables V2 review-request messages when true.
FEATURE_REVIEWS=false
