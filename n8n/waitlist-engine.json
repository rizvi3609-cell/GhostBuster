        "id": "verify-shared-secret-signature",
        "name": "Verify Shared Secret Signature",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst headers = $json.headers || {};\nconst timestamp = String(headers['x-ghostbuster-timestamp'] || headers['X-Ghostbuster-Timestamp'] || '');\nconst supplied = String(headers['x-ghostbuster-signature'] || headers['X-Ghostbuster-Signature'] || '');\nconst rawBody = String($json.rawBody || JSON.stringify($json.body || {}));\nconst seconds = Number(timestamp);\nconst fresh = Number.isFinite(seconds) && Math.abs(Math.floor(Date.now() / 1000) - seconds) <= 300;\nconst expected = crypto.createHmac('sha256', $env.GHOSTBUSTER_SHARED_SECRET).update(`${timestamp}.${rawBody}`).digest('hex');\nconst sameLength = supplied.length === expected.length;\nconst valid = fresh && sameLength && crypto.timingSafeEqual(Buffer.from(supplied), Buffer.from(expected));\nreturn [{ json: { valid, campaignId: $json.body?.campaignId || null } }];"
        }
      },
