      {
        "id": "compute-next-allowed-window",
        "name": "Compute Next Allowed Window",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          -120
        ],
        "parameters": {
          "jsCode": "const row = $json;\nconst now = new Date();\nconst timezone = row.timezone || row.clinic_timezone;\nconst start = String(row.quiet_hours_start).slice(0, 5);\nconst end = String(row.quiet_hours_end).slice(0, 5);\nconst parts = new Intl.DateTimeFormat('en-CA', { timeZone: timezone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(now);\nconst values = Object.fromEntries(parts.map((part) => [part.type, part.value]));\nconst minute = Number(values.hour) * 60 + Number(values.minute);\nconst [sh, sm] = start.split(':').map(Number);\nconst [eh, em] = end.split(':').map(Number);\nconst startMinute = sh * 60 + sm;\nconst endMinute = eh * 60 + em;\nconst within = startMinute !== endMinute && (startMinute < endMinute ? minute >= startMinute && minute < endMinute : minute >= startMinute || minute < endMinute);\nif (within) return [{ json: { ...row, withinWindow: true, nextAllowedAt: now.toISOString() } }];\nlet candidate = new Date(Math.floor(now.getTime() / 60000) * 60000 + 60000);\nfor (;;) {\n  const candidateParts = new Intl.DateTimeFormat('en-CA', { timeZone: timezone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(candidate);\n  const candidateValues = Object.fromEntries(candidateParts.map((part) => [part.type, part.value]));\n  const candidateMinute = Number(candidateValues.hour) * 60 + Number(candidateValues.minute);\n  const allowed = startMinute !== endMinute && (startMinute < endMinute ? candidateMinute >= startMinute && candidateMinute < endMinute : candidateMinute >= startMinute || candidateMinute < endMinute);\n  if (allowed) return [{ json: { ...row, withinWindow: false, nextAllowedAt: candidate.toISOString() } }];\n  candidate = new Date(candidate.getTime() + 60000);\n}"
        }
